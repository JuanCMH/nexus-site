# Dirección pública del sitio (canónicas, sitemap, Open Graph).
# En Vercel se define por entorno; en local no hace falta.
NEXT_PUBLIC_SITE_URL=

# Dirección de la app web. Por defecto, https://app.n3xus.cloud: a ella lleva
# «Iniciar sesión». Definida vacía, el sitio no enseña ese enlace.
NEXT_PUBLIC_APP_URL=

# Dirección del backend de nexus-app que recibe las solicitudes de acceso
# (POST <dirección>/access-requests). Vacía mientras el endpoint no exista:
# el formulario avisa que las solicitudes aún no están abiertas.
NEXT_PUBLIC_API_URL=

# Repositorio público de GitHub con los instaladores (propietario/nombre).
# Por defecto, JuanCMH/nexus-app-releases.
NEXUS_RELEASES_REPO=
