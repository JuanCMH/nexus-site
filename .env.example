# Dirección pública del sitio (canónicas, sitemap, Open Graph).
# En Vercel se define por entorno; en local no hace falta.
NEXT_PUBLIC_SITE_URL=

# Dirección de la app web (app.<dominio>). Vacía mientras no esté publicada:
# el sitio no enseña «Entrar» sin ella.
NEXT_PUBLIC_APP_URL=

# Repositorio público de GitHub con los instaladores (propietario/nombre).
# Por defecto, JuanCMH/nexus-desktop-releases; cambia al renombrarlo.
NEXUS_RELEASES_REPO=
